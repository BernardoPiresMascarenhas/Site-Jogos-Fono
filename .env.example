# =============================================================
#  Jogos da Ana — variáveis de ambiente (EXEMPLO, sem dados reais)
#  Copie para .env.local em desenvolvimento. Na Vercel, cadastre
#  em Settings → Environment Variables.
# =============================================================

# Segredo usado para assinar/criptografar o cookie de sessão.
# Gere com: npm run admin -- segredo   (ou: openssl rand -base64 32)
# Trocar este valor encerra TODAS as sessões abertas.
AUTH_SECRET=

# Lista de usuários autorizados. Gere/edite SEMPRE com a ferramenta:
#   npm run admin -- adicionar comprador@exemplo.com
#   npm run admin -- exportar
# Use SEMPRE o formato "base64:<...>" gerado pela ferramenta. JSON puro também é
# aceito, mas o "$" dos hashes pode ser corrompido pelo carregador de .env do Next.
# Estrutura (antes da codificação base64):
# [{"email":"comprador@exemplo.com","passwordHash":"$2b$12$...","active":true,"expiresAt":"2026-12-31","name":"Nome"}]
AUTH_USERS_JSON=

# Apenas fora da Vercel (ex.: "npm start" local ou outro provedor):
# AUTH_TRUST_HOST=true
